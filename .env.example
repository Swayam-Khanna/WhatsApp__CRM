# Database (Neon Postgres with Pooled Connection)
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-endpoint-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATA_PROVIDER=neon

# Object Storage (Neon Object Storage / S3-Compatible)
OBJECT_STORAGE_ENDPOINT=https://your-s3-endpoint.storage.c-4.ap-southeast-1.aws.neon.tech
OBJECT_STORAGE_BUCKET=pm-assets
OBJECT_STORAGE_ACCESS_KEY_ID=your_access_key_id
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_secret_access_key
OBJECT_STORAGE_REGION=ap-southeast-1

# AWS SDK Aliases
AWS_ENDPOINT_URL_S3=https://your-s3-endpoint.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_BUCKET=pm-assets
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=ap-southeast-1

# Application Domain & Security
NEXT_PUBLIC_APP_URL=https://market.prajnaa.in
BETTER_AUTH_URL=https://market.prajnaa.in
BETTER_AUTH_SECRET=your_better_auth_secret_min_32_characters
PAN_ENCRYPTION_KEY=your_pan_encryption_secret_min_32_characters
PORT=3000
NODE_ENV=production

# Cashfree Payments & KYC
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01

# Razorpay Payments
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Online Payments Feature Flag (false = COD and WhatsApp orders only)
ONLINE_PAYMENTS_ENABLED=false
NEXT_PUBLIC_ONLINE_PAYMENTS_ENABLED=false

# Prajnaa Official WhatsApp Business Platform & Cloud API
ADMIN_WHATSAPP_NUMBER=917650065690
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# Resend Email Service
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=Prajnaa Market <orders@market.prajnaa.in>

# Government of India Open Government Data (OGD) Pincode API
OGD_PINCODE_API_KEY=your_ogd_pincode_key
OGD_PINCODE_API_URL=https://api.data.gov.in/resource/5c2f62fe-5afa-4119-a499-fec9d604d5bd
OGD_PINCODE_RESOURCE_ID=5c2f62fe-5afa-4119-a499-fec9d604d5bd

# Web3Forms
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# OAuth Providers
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# WhatsApp CRM Integration
WHATSAPP_CRM_URL=https://whatsapp-crm-qje9.vercel.app
WHATSAPP_CRM_API_KEY=
